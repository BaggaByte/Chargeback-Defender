# RocketRide Portable Pipeline Definition
# Pipeline: Dispute Analyzer
# Version: 2.1.0
# Description: Multi-stage chargeback dispute analysis, evidence extraction, missing-evidence detection, rebuttal generation, and anti-hallucination verification.

name: dispute-analyzer
version: 2.1.0

marketplace:
  id: "chargeback-defender-dispute-analyzer"
  title: "Chargeback Defender — Autonomous Dispute Intelligence"
  summary: "Enterprise-grade AI pipeline for payment dispute defense, Compelling Evidence 3.0 matching, and anti-hallucination rebuttal generation."
  category: "Fintech & Payments / Fraud & Risk"
  author: "Chargeback Defender Inc."
  pricing_model: "Per Resolution ($0.50 / dispute)"
  license: "Commercial"
  min_engine_version: "2.4.0"
  tags:
    - chargeback
    - stripe
    - visa-ce-3.0
    - mastercard-ce-2.0
    - dispute-defense
    - anti-hallucination
  documentation_url: "https://chargebackdefender.io/docs/rocketride"

inputs:
  schema:
    type: object
    required: [dispute, customer, transaction, evidence]
    properties:
      dispute:
        type: object
        required: [id, reason, amount, currency, cardBrand]
      customer:
        type: object
      transaction:
        type: object
      evidence:
        type: array

nodes:
  - id: validate_input
    type: schema_validator
    config:
      reject_on_error: true
      required_fields:
        - "dispute.id"
        - "dispute.reason"
        - "dispute.amount"
        - "dispute.currency"
        - "dispute.cardBrand"
    next: normalize_evidence

  - id: normalize_evidence
    type: extract_facts
    config:
      categories:
        - type: SHIPPING_PROOF
          extract: ["tracking_number", "carrier", "delivery_status", "signature_present", "coordinates_match"]
        - type: ORDER_DETAILS
          extract: ["item_summary", "avs_result", "cvc_result", "three_d_secure"]
        - type: CUSTOMER_COMMUNICATION
          extract: ["support_interaction_history", "admissions", "satisfaction_signals"]
        - type: TOS_AGREEMENT
          extract: ["terms_version", "accepted_timestamp", "cancellation_clause"]
    next: analyze_evidence

  - id: analyze_evidence
    type: rule_evaluator
    config:
      evaluate_per_item: true
      scoring_weights:
        three_d_secure_authenticated: 30
        direct_signature_delivery: 25
        avs_and_cvc_match: 15
        verified_customer_login: 15
        published_tos_accepted: 15
    next: analyze_dispute_reason

  - id: analyze_dispute_reason
    type: network_rules_engine
    config:
      compelling_evidence_frameworks:
        visa: "Visa Compelling Evidence 3.0 (CE 3.0)"
        mastercard: "Mastercard Compelling Evidence 2.0"
        amex: "American Express Dispute Representment Standards"
        discover: "Discover Network Dispute Defense Guidelines"
    next: calculate_evidence_strength

  - id: calculate_evidence_strength
    type: probability_calculator
    config:
      calibration_model: "card_brand_weighted_v2"
      output_metrics:
        - overall_strength_score
        - win_probability_percent
        - confidence_score
    next: detect_missing_evidence

  - id: detect_missing_evidence
    type: gap_analyzer
    config:
      check_rules_by_reason: true
      flag_high_impact_gaps: true
    next: generate_response

  - id: generate_response
    type: llm_generator
    config:
      provider: gemini
      model: gemini-3.7-flash
      temperature: 0.1 # Low temperature to prevent hallucination
      strict_fact_grounding: true
      prohibit_unsupported_assertions: true
    next: verify_output

  - id: verify_output
    type: hallucination_guard
    config:
      verify_against_input_evidence: true
      fail_on_unsupported_claims: true
      fail_on_internal_contradictions: true
      enforce_human_approval_gate: true
    next: format_output

  - id: format_output
    type: response_json
    config:
      schema: dispute_ai_analysis_v2
