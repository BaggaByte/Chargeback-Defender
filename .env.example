# ==============================================================================
# CHARGEBACK DEFENDER — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# ------------------------------------------------------------------------------

# PostgreSQL Database connection string
# Example: postgresql://postgres:password@db.example.com:5432/chargeback_defender?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/chargeback_defender"

# NextAuth / Auth.js secret key for encrypting JWT tokens and sessions
# Generate with: openssl rand -base64 33
AUTH_SECRET="your-32-character-random-secret-key-here"

# Canonical URL of the application in production (or http://localhost:4000 for local dev)
AUTH_URL="http://localhost:4000"

# Stripe Secret API Key (from Stripe Dashboard -> Developers -> API Keys)
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Signing Secret (from Stripe Dashboard -> Developers -> Webhooks)
# Required for cryptographic signature verification in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 2. AI PROVIDER & PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------

# Primary Dispute AI Provider ('rocketride' | 'gemini')
# Defaults to 'rocketride'
AI_PROVIDER="rocketride"

# Optional explicit observable fallback provider ('gemini' | 'rocketride')
AI_FALLBACK_PROVIDER="gemini"

# Google Gemini API Key for AI dispute scoring, analysis, and rebuttal generation
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# RocketRide AI Engine pipeline execution
# Official SDK/API credentials (server-only, never exposed to client)
ROCKETRIDE_API_KEY=""
ROCKETRIDE_ENDPOINT="https://api.rocketride.ai:443"
# Supported environment aliases:
# ROCKETRIDE_APIKEY=""
# ROCKETRIDE_URI="https://api.rocketride.ai:443"

# ------------------------------------------------------------------------------
# 3. RUNTIME & CONNECTION POOL SETTINGS
# ------------------------------------------------------------------------------

# Max PostgreSQL connections per pool (defaults to 10 for serverless safety)
DB_MAX_CONNECTIONS=10

# Node runtime environment (development, test, production)
NODE_ENV="development"